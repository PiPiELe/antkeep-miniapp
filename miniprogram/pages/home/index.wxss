.hero-card { position: relative; overflow: hidden; height: 260rpx; border-radius: 32rpx; background: #204c3b; color: #fff; margin: 40rpx 0; padding: 34rpx; }
.second-line { margin-top: 0; }
.hero-icon { width: 74rpx; height: 74rpx; border-radius: 22rpx; background: #d9e8b4; color: #204c3b; text-align: center; line-height: 74rpx; font-size: 40rpx; font-weight: 700; }
.hero-copy { position: relative; z-index: 1; font-size: 34rpx; font-weight: 700; line-height: 1.4; margin-top: 25rpx; }
.hero-copy.next-line { margin-top: 0; }
.hero-orbit { position: absolute; width: 390rpx; height: 390rpx; border: 2rpx solid rgba(217,232,180,.33); border-radius: 50%; right: -80rpx; bottom: -205rpx; box-shadow: 0 0 0 55rpx rgba(217,232,180,.05), 0 0 0 110rpx rgba(217,232,180,.04); }
.article-title { margin-top: 20rpx; }
.preview { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; margin-top: 10rpx; }
.step-card { display: flex; gap: 22rpx; align-items: center; }
.step-number { flex: none; background: #e9f4ed; color: #23634b; width: 58rpx; height: 58rpx; line-height: 58rpx; text-align: center; border-radius: 50%; font-size: 26rpx; font-weight: 700; }
.step-copy { flex: 1; min-width: 0; }
.summary { margin: -12rpx 0 24rpx; }
.content-footer { text-align: center; color: #9aa89e; font-size: 22rpx; padding: 25rpx 0; }
.retry { margin-top: 16rpx; }
